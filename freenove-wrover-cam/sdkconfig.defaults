# ESP-IDF settings for the camera demo.
# Serial setup uses the default UART0 console through the CH340 bridge.

# The Freenove board carries a 4 MB flash; the IDF default is 2 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Wi-Fi, mbedTLS, the certificate bundle and the camera driver do not fit a 1 MB app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# HTTPS to https.warbletiot.com uses the ESP x509 certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# PSRAM: a JPEG frame buffer does not fit internal DRAM beside Wi-Fi and mbedTLS.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
