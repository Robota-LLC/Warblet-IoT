# The options each ST object this image is built from is compiled with,
# warnings and dependency output left out: make st-audit-write writes this
# after a person has audited them (tools/st_audit.sh).
options 1
  -mcpu=cortex-m33
  -mthumb
  -mfpu=fpv5-sp-d16
  -mfloat-abi=hard
  -DUSE_HAL_DRIVER
  -DUSE_FULL_LL_DRIVER
  -DUSE_FULL_ASSERT
  -DSTM32WBA65xx
  -DOPENTHREAD_FTD
  -DMAC
  -DMAC_LAYER
  -DDISABLE_RFTS_EXT_EVNT_HNDLR=1
  -DPHY_40nm_3_40_a
  -DOPENTHREAD_CONFIG_FILE=<stm32wba-openthread-ftd-config.h>
  -DOPENTHREAD_PROJECT_CORE_CONFIG_FILE=<stm32wba-openthread-ftd-config.h>
