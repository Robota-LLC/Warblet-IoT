{
  "slug": "demo-system-monitor",
  "chips": [],
  "board": "Your computer: Linux, Raspberry Pi OS, macOS or Windows",
  "network": "none",
  "starter": false,
  "result": "See this computer's disks and vitals on your dashboard, and get an email before a disk fills up.",
  "firstMessage": "It sends its first report as soon as it starts, then one a minute.",
  "spec": {
    "transport": "http",
    "securityLevel": 1,
    "retentionDays": 7,
    "uiConfig": {}
  },
  "routine": {
    "file": "disk-full.star",
    "name": "System monitor: email when a disk is nearly full",
    "scope": "spec",
    "minIntervalMs": 0
  },
  "firmware": {
    "kind": "external",
    "files": ["warblet_monitor.py"],
    "connect": [
      {
        "label": "Linux, Raspberry Pi OS or macOS",
        "text": "curl -fsSLo warblet_monitor.py https://raw.githubusercontent.com/Robota-LLC/Warblet-IoT/refs/tags/v1.5.0/system-monitor/warblet_monitor.py\npython3 warblet_monitor.py",
        "steps": [
          {
            "title": "Download the script from GitHub",
            "text": "curl -fsSLo warblet_monitor.py https://raw.githubusercontent.com/Robota-LLC/Warblet-IoT/refs/tags/v1.5.0/system-monitor/warblet_monitor.py"
          },
          {
            "title": "Run it, and paste the setup code when it asks",
            "text": "python3 warblet_monitor.py",
            "asksForCode": true
          }
        ]
      },
      {
        "label": "Windows",
        "text": "curl.exe -fsSLo warblet_monitor.py https://raw.githubusercontent.com/Robota-LLC/Warblet-IoT/refs/tags/v1.5.0/system-monitor/warblet_monitor.py\npython warblet_monitor.py",
        "steps": [
          {
            "title": "Download the script from GitHub",
            "text": "curl.exe -fsSLo warblet_monitor.py https://raw.githubusercontent.com/Robota-LLC/Warblet-IoT/refs/tags/v1.5.0/system-monitor/warblet_monitor.py"
          },
          {
            "title": "Run it, and paste the setup code when it asks",
            "text": "python warblet_monitor.py",
            "asksForCode": true
          }
        ]
      }
    ]
  },
  "provision": {
    "host": "https.warbletiot.com",
    "commands": [],
    "knobs": {
      "level": {"max": 1}
    }
  }
}
